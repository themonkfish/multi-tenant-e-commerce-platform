{
  "name": "multi-tenant-e-commerce-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:demo": "node scripts/dev-demo.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:demo:roles": "node scripts/seed-role-demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.ts vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:sbom": "npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type application",
    "security:notices": "node scripts/dependency-notices.mjs",
    "platform-store:backup": "node scripts/platform-store-backup.mjs backup",
    "platform-store:restore": "node scripts/platform-store-backup.mjs restore",
    "platform-store:rotate": "node scripts/platform-store-backup.mjs rotate",
    "platform-store:migrate:export": "node scripts/platform-store-migration.mjs export",
    "platform-store:migrate:preflight": "node scripts/platform-store-migration.mjs preflight",
    "test:platform-backup": "node --test scripts/platform-store-backup.test.mjs",
    "test:platform-migration": "node --test scripts/platform-store-migration.test.mjs",
    "test:supabase-migrations": "node --test scripts/supabase-production-migration.test.mjs",
    "supabase:migration:preflight": "node scripts/supabase-production-migration.mjs preflight",
    "supabase:migration:deploy": "node scripts/supabase-production-migration.mjs deploy",
    "format": "prettier --write src supabase README.md package.json next.config.ts vitest.config.mts",
    "format:check": "prettier --check src supabase README.md package.json next.config.ts vitest.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@node-rs/argon2": "^2.2.2",
    "@smithy/node-http-handler": "^4.12.1",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.104.5",
    "jose": "^6.2.13",
    "mongodb": "^7.7.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.9",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
