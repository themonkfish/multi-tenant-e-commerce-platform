# Local file store is for development only. Production should use the platform
# Supabase project and keep its service key server-only.
PLATFORM_STORE=file
PLATFORM_STORE_FILE=.local/platform-store.json
PLATFORM_SECRET_KEY=
SESSION_SECRET=
SETUP_TOKEN=
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
# Stripe test-mode only; configure the webhook endpoint at /api/webhooks/stripe.
# For local development, forward test events with:
# stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional HMAC secret for POST /api/webhooks/carrier carrier events.
# Send hex or sha256=<hex> in x-carrier-signature.
CARRIER_WEBHOOK_SECRET=
# Optional Shiprocket credentials for live shipment creation and labels.
# Configure the pickup location exactly as registered in Shiprocket.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Optional token used to verify Shiprocket webhook requests at
# /api/webhooks/logistics?tenantId=<tenant-uuid>.
SHIPROCKET_WEBHOOK_TOKEN=
# Optional bearer token for protected Prometheus text at /api/metrics.
OBSERVABILITY_METRICS_TOKEN=

# Optional shared Redis REST rate limiter (for example, Upstash-compatible).
# When both values are set, mutations use the distributed limiter instead of
# the PlatformStore's local/Supabase counter.
DISTRIBUTED_RATE_LIMIT_URL=
DISTRIBUTED_RATE_LIMIT_TOKEN=
DISTRIBUTED_RATE_LIMIT_PREFIX=platform
# open or closed; production defaults to closed, development/test to open.
DISTRIBUTED_RATE_LIMIT_FAIL_MODE=
# Standard Upstash names are accepted as aliases:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional invitation email delivery through Resend; leave both blank for manual links.
RESEND_API_KEY=
INVITATION_EMAIL_FROM=
# Optional Inngest background-job event and signing keys.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional Vercel project-domain and TLS automation.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Enabled only by the isolated local demo launcher; never enable outside the demo store.
DEMO_CHECKOUT_ENABLED=false

# Required only when PLATFORM_STORE=supabase
# PLATFORM_STORE=supabase
# PLATFORM_SUPABASE_URL=
# PLATFORM_SUPABASE_SERVICE_KEY=
