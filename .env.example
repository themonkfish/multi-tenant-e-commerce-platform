# Local file store is for development only. Production should use the platform
# Supabase project and keep its service key server-only.
PLATFORM_STORE=file
PLATFORM_STORE_FILE=.local/platform-store.json
PLATFORM_SECRET_KEY=
SESSION_SECRET=
SETUP_TOKEN=
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost

# Required only when PLATFORM_STORE=supabase
# PLATFORM_STORE=supabase
# PLATFORM_SUPABASE_URL=
# PLATFORM_SUPABASE_SERVICE_KEY=
