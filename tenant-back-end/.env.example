PORT=4100
HOST=127.0.0.1
DATABASE_PROVIDER=sqlite
DATABASE_FILE=./data/tenant-backend.sqlite

# Configure either one local tenant key:
DEFAULT_TENANT_ID=local-tenant
TENANT_API_KEY=

# Or multiple tenant keys as a JSON object (tenant ID -> API key):
# TENANT_API_KEYS={"tenant-uuid-1":"first-random-secret","tenant-uuid-2":"second-random-secret"}
